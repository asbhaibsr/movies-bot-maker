<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{file_name}} | AS Bhai Bot</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css">
    <style>
        :root { --primary: #6c47ff; --bg: #0f0f1a; --card: #1a1a2e; }
        * { box-sizing: border-box; }
        body { background: var(--bg); color: #eee; font-family: 'Segoe UI', sans-serif; min-height: 100vh; display: flex; flex-direction: column; }
        .navbar { background: rgba(26,26,46,0.95); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(108,71,255,0.3); }
        .brand { font-size: 1.3rem; font-weight: 700; background: linear-gradient(135deg, #6c47ff, #ff6b9d); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .hero { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); padding: 60px 0; }
        .card-dark { background: var(--card); border: 1px solid rgba(108,71,255,0.2); border-radius: 16px; }
        .btn-primary-custom { background: linear-gradient(135deg, #6c47ff, #9b59b6); border: none; border-radius: 12px; padding: 12px 32px; font-weight: 600; transition: all 0.3s; }
        .btn-primary-custom:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(108,71,255,0.4); }
        .file-icon { font-size: 5rem; }
        .badge-custom { background: rgba(108,71,255,0.2); border: 1px solid rgba(108,71,255,0.4); color: #a78bfa; border-radius: 20px; padding: 4px 14px; }
        footer { background: #0a0a14; border-top: 1px solid rgba(255,255,255,0.05); margin-top: auto; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg sticky-top">
  <div class="container">
    <span class="brand">🎬 AS Bhai Bot</span>
    <div class="d-flex gap-2">
      <a href="https://t.me/asbhai_bsr" class="btn btn-sm btn-outline-light rounded-pill" target="_blank">📢 Updates</a>
    </div>
  </div>
</nav>

<section class="hero">
  <div class="container text-center py-3">
    <div class="file-icon mb-3">🎬</div>
    <h2 class="fw-bold mb-2">{{file_name}}</h2>
    <div class="d-flex justify-content-center gap-2 flex-wrap mb-4">
      <span class="badge-custom">📁 {{file_size}}</span>
      <span class="badge-custom">🎞️ Movie File</span>
    </div>
    
    <div class="card-dark p-4 mx-auto" style="max-width:500px">
      <p class="text-muted mb-4">Aapki file ready hai. Neeche se stream ya download karo.</p>
      <div class="d-grid gap-2">
        <a href="{{stream_link}}" class="btn btn-primary-custom btn-lg text-white">
          ▶️ Stream Online
        </a>
        <a href="{{download_link}}" class="btn btn-outline-light btn-lg">
          ⬇️ Download
        </a>
      </div>
      <p class="text-muted mt-3 small">⚠️ Link kuch ghanton mein expire ho jaata hai</p>
    </div>
  </div>
</section>

<section class="container py-5">
  <div class="row g-4 text-center">
    <div class="col-md-4">
      <div class="card-dark p-4 h-100">
        <div class="fs-2 mb-2">⚡</div>
        <h5>Fast Streaming</h5>
        <p class="text-muted small">High speed streaming with no buffering</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card-dark p-4 h-100">
        <div class="fs-2 mb-2">🎬</div>
        <h5>All Formats</h5>
        <p class="text-muted small">MP4, MKV, AVI aur sab formats</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card-dark p-4 h-100">
        <div class="fs-2 mb-2">🔒</div>
        <h5>Secure</h5>
        <p class="text-muted small">Safe aur secure file delivery</p>
      </div>
    </div>
  </div>
</section>

<footer class="py-4 text-center text-muted small">
  <div class="container">
    <p class="mb-1">🤖 Powered by <a href="https://t.me/asbhai_bsr" class="text-decoration-none" style="color:#a78bfa">@asbhai_bsr</a></p>
    <p class="mb-0">© 2024 AS Bhai Bot | <a href="https://t.me/aschat_group" class="text-decoration-none text-muted">Support</a></p>
  </div>
</footer>

</body>
</html>
