# 1. Telegram API — https://my.telegram.org
API_ID=12345678
API_HASH=abcdefghijklmnop
BOT_TOKEN=123456789:AABBccDDeeFFggHH

# 2. Tera Telegram ID (Admin)
ADMINS=7315805581

# 3. Sirf 1 MongoDB Atlas — atlas.mongodb.com pe free account banao
DATABASE_URI=mongodb+srv://username:password@cluster.mongodb.net
DATABASE_NAME=asbhaibot

# 4. Telegram Channels
LOG_CHANNEL=-100xxxxxxxxxx
SUPPORT_CHAT=aschat_group
CHNL_LNK=https://t.me/asbhai_bsr
OWNER_LNK=https://t.me/asbhai_bsr

# 5. Clone System
CLONE_MODE=True
PUBLIC_FILE_CHANNEL=-100xxxxxxxxxx

# 6. Shortlink (optional - paise kamane ke liye)
VERIFY=False
VERIFY_SHORTLINK_URL=shortxlinks.com
VERIFY_SHORTLINK_API=your_api_key

# 7. Premium
PREMIUM_AND_REFERAL_MODE=True
PAYMENT_QR=https://your-qr-image-link.jpg

# 8. Free Trial
FREE_TRIAL_DAYS=30
